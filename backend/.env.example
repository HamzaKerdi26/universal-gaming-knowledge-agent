PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/gaming_agent
NODE_ENV=development

# Phase 9A — backend authentication
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=3600

# Phase 10B — global-write administrators (comma-separated Prisma User IDs)
# Registration never grants admin access. Leave empty to deny all admin operations.
ADMIN_USER_IDS=

# Browser origins allowed to call the API. Development defaults to localhost:5173.
# Set explicit production origins; wildcard origins are rejected.
FRONTEND_ORIGINS=http://localhost:5173

# In-process per-IP or per-user request ceilings (single backend instance only).
RATE_LIMIT_WINDOW_MS=60000
AUTH_REGISTER_LIMIT=5
AUTH_LOGIN_LIMIT=10
CHAT_LIMIT=20
RAG_INGEST_LIMIT=20
SOURCE_IMPORT_LIMIT=20
RAG_SEARCH_LIMIT=30
SOURCE_SEARCH_LIMIT=30

# Phase 3 — AI chat configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Phase 5 — Embeddings + Qdrant vector search
# Reuses GEMINI_API_KEY above (same Gemini account, different model).
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=gaming_knowledge

# Phase 8 — Game data sources
# RAWG (https://rawg.io/apidocs) — free tier. The Wikipedia data source
# needs no credentials. If RAWG_API_KEY is not set, the "rawg" source is
# simply not registered (GET /api/sources won't list it) rather than the
# server failing to start.
RAWG_API_KEY=your-rawg-api-key-here
